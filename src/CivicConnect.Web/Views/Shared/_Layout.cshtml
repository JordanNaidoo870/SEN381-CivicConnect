<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - CivicConnect</title>

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg civic-navbar">
            <div class="container">
                <a class="navbar-brand civic-brand"
                   asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">C</span>
                    CivicConnect
                </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation" aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Community" asp-action="MyReports">Community Reports</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Community" asp-action="Dashboard">My Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Worker" asp-action="Dashboard">Worker Portal</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Log In</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-civic-primary ms-lg-2"
                           asp-controller="Account" asp-action="Register">Sign Up</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main role="main">
    @RenderBody()
</main>

<footer class="civic-footer">
    <div class="container footer-content">
        <div>
            <a class="navbar-brand civic-brand"
               asp-controller="Home" asp-action="Index">
                <span class="brand-icon">C</span>
                CivicConnect
            </a>
            <p class="footer-description">Connecting communities with the change they need.</p>
        </div>

        <div class="footer-links">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Community" asp-action="MyReports">Community Reports</a>
            <a asp-controller="Account" asp-action="Login">Log In</a>
        </div>
    </div>

    <div class="container footer-bottom">
        <p class="mb-0">CivicConnect &copy; @DateTime.Now.Year — Helping communities report and track local issues.</p>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
