<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] — CivicConnect</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
 <header>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark" aria-label="Main navigation">
   <div class="container">
    <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">CivicConnect</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="navigation">
     <ul class="navbar-nav me-auto">
      @if (User.IsInRole(Roles.Requester)) {
       <li class="nav-item"><a class="nav-link" asp-controller="Requests" asp-action="Index">My requests</a></li>
       <li class="nav-item"><a class="nav-link" asp-controller="Requests" asp-action="Create">Submit request</a></li>
      }
      @if (User.IsInRole(Roles.Staff) || User.IsInRole(Roles.Administrator)) {
       <li class="nav-item"><a class="nav-link" asp-controller="Staff" asp-action="Queue">Staff queue</a></li>
       <li class="nav-item"><a class="nav-link" asp-controller="Staff" asp-action="Assigned">Assigned to me</a></li>
      }
      @if (User.IsInRole(Roles.Management) || User.IsInRole(Roles.Administrator)) {
       <li class="nav-item"><a class="nav-link" asp-controller="Management" asp-action="Index">Management</a></li>
      }
      @if (User.IsInRole(Roles.Administrator)) {
       <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="CreateUser">Add staff/management</a></li>
      }
     </ul>
     <div class="d-flex gap-2 align-items-center">
      @if (User.Identity?.IsAuthenticated == true) {
       <span class="text-light small">@User.Identity.Name</span>
       <form asp-controller="Account" asp-action="Logout" method="post" class="m-0"><button class="btn btn-outline-light btn-sm" type="submit">Log out</button></form>
      } else {
       <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Login">Log in</a>
       <a class="btn btn-info btn-sm" asp-controller="Account" asp-action="Register">Register</a>
      }
     </div>
    </div>
   </div>
  </nav>
 </header>
 <main class="container mt-4 mb-5" id="main-content">
  @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
  @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
  @RenderBody()
 </main>
 <footer class="border-top bg-light py-3"><div class="container small text-muted">CivicConnect • Community service requests • SEN381</div></footer>
 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
 @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
