@{
    ViewData["Title"] = "Review Report";
}

<div class="details-card">
    <div class="details-top">
        <div>
            <span class="eyebrow">REFERENCE CC-@ViewBag.ReportId</span>
            <h1>Potholes on main road</h1>
            <p class="page-description">Soweto, Johannesburg · Submitted 08 October 2026</p>
        </div>

        <span class="status-badge status-progress">In Progress</span>
    </div>

    <hr>

    <h2>Issue Description</h2>
    <p>Several potholes have developed along the road, creating difficulties for local drivers and residents.</p>

    <div class="details-grid">
        <div><span class="detail-label">Category</span><strong>Roads and Transport</strong></div>
        <div><span class="detail-label">Location</span><strong>Soweto, Johannesburg</strong></div>
        <div><span class="detail-label">Reference</span><strong>CC-@ViewBag.ReportId</strong></div>
        <div><span class="detail-label">Current Status</span><strong>In Progress</strong></div>
    </div>

    <div class="form-actions">
        <a asp-controller="Worker" asp-action="UpdateStatus" asp-route-id="@ViewBag.ReportId"
           class="btn btn-civic-primary">Update Status →</a>
    </div>
</div>
</section>
