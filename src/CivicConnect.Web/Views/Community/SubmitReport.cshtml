@{
    ViewData["Title"] = "Submit a Report";
}
<section class="form-page">
    <div class="page-back">
        <a asp-controller="Community" asp-action="Dashboard" class="text-link">← Back to dashboard</a>
    </div>
<div class="form-page-heading">
    <span class="eyebrow">HELP IMPROVE YOUR COMMUNITY</span>
    <h1>Submit a Report</h1>
    <p>Provide details about the issue so it can be understood and addressed.</p>
</div>

<div class="form-card">
    <form class="demo-form" data-success="Your report has been submitted in the demonstration. No report has been saved to a database.">
        <div class="form-group">
            <label for="title">Report title *</label>
            <input id="title" class="form-control" placeholder="Briefly describe the issue" maxlength="100" required>
        </div>

        <div class="form-group">
            <label for="category">Issue category *</label>
            <select id="category" class="form-select" required>
                <option value="">Select a category</option>
                <option>Roads and Transport</option>
                <option>Water and Sanitation</option>
                <option>Electricity</option>
                <option>Waste Management</option>
                <option>Public Safety</option>
                <option>Public Facilities</option>
                <option>Other</option>
            </select>
        </div>

        <div class="form-group">
            <label for="location">Location *</label>
            <input id="location" class="form-control" placeholder="Street, suburb or community" required>
        </div>

        <div class="form-group">
            <label for="description">Description *</label>
            <textarea id="description" class="form-control" rows="5" maxlength="1000" placeholder="Explain what happened and where..." required></textarea>
            <small class="field-help">Include enough information to help someone understand the issue.</small>
        </div>

        <div class="form-group">
            <label for="photo">Supporting photo (optional)</label>
            <input id="photo" type="file" class="form-control" accept="image/*">
            <small class="field-help">Prototype only. The photo will not be uploaded.</small>
        </div>

        <div class="form-actions">
            <a asp-controller="Community" asp-action="Dashboard" class="btn btn-outline-civic">Cancel</a>
            <button type="submit" class="btn btn-civic-primary">Submit Report →</button>
        </div>
    </form>
</div>
</section>
