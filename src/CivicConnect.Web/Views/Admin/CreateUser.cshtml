@model StaffAccountForm
@{ ViewData["Title"] = "Add staff account"; }
<h1 class="h2">Create staff or management account</h1>
<p class="text-muted">Only system administrators may create privileged users. Public registration always creates a requester.</p>
<div class="card narrow"><div class="card-body">
<form asp-action="CreateUser" method="post">
 <div asp-validation-summary="All" class="text-danger" role="alert"></div>
 <div class="mb-3"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control"/></div>
 <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control"/></div>
 <div class="mb-3"><label asp-for="TemporaryPassword" class="form-label"></label><input asp-for="TemporaryPassword" type="password" class="form-control"/></div>
 <div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select"><option value="Staff">Service Staff</option><option value="Management">Management</option></select></div>
 <button class="btn btn-primary" type="submit">Create account</button>
</form></div></div>
<p class="small text-muted">For real deployment, add a secure password-reset or invitation workflow before onboarding users.</p>
